# Config pública de Firebase (Web API Key — no es secreta, pero igual no se
# hardcodea). Copiar a `.env` y completar con los valores reales del
# proyecto Firebase (los mismos que usa frontend/.env.local).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Emuladores: true para desarrollo local contra `firebase emulators:start`
# en la raíz del monorepo.
EXPO_PUBLIC_USE_EMULATORS=false

# Host de los emuladores: 10.0.2.2 para el emulador Android (AVD),
# la IP LAN del PC (ej. 192.168.1.50) para un dispositivo físico en la
# misma red. No se usa si EXPO_PUBLIC_USE_EMULATORS=false.
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2

# URL de la API en producción/staging (Firebase Hosting con el rewrite
# /api -> función `api`). No se usa si EXPO_PUBLIC_USE_EMULATORS=true.
EXPO_PUBLIC_API_URL=https://smartone-v3.web.app/api
