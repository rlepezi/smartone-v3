rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones auxiliares de seguridad
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Custom claims (rol, mandanteId) — mismos dos únicos claims de todo
    // el sistema, ver authMiddleware.js en el backend.
    function tieneRol(rol) {
      return isAuthenticated() && request.auth.token.rol == rol;
    }

    function esDelPropioMandante(mandanteId) {
      return isAuthenticated() && request.auth.token.mandanteId == mandanteId;
    }

    // Regla para la colección de usuarios
    match /usuarios/{userId} {
      // Cada usuario autenticado solo puede leer su propio perfil
      allow read: if isOwner(userId);

      // La creación y edición se restringe al Backend / Admin SDK
      allow write: if false;
    }

    // Sesiones (telemetría de accesos, Fase B de "Usuarios: actividad,
    // métricas y gestión de accesos"): sin escritura desde el cliente en
    // ningún caso — iniciar/latido/cerrar pasan siempre por la API
    // (Admin SDK). Lectura: superadmin a todas; mandante_admin a las de
    // su propio Mandante; cada usuario a las propias.
    match /sesiones/{sesionId} {
      allow read: if tieneRol("superadmin") ||
          (tieneRol("mandante_admin") &&
           esDelPropioMandante(resource.data.mandanteId)) ||
          isOwner(resource.data.usuarioId);
      allow write: if false;
    }

    // Métricas diarias de usuario (Fase C): mismo criterio de lectura que
    // Sesiones, nunca escritura desde el cliente — el trigger de
    // Bitácora y sesionService (Admin SDK) son los únicos que escriben.
    match /metricasUsuarioDiarias/{docId} {
      allow read: if tieneRol("superadmin") ||
          (tieneRol("mandante_admin") &&
           esDelPropioMandante(resource.data.mandanteId)) ||
          isOwner(resource.data.usuarioId);
      allow write: if false;
    }

    // Personas y Maquinarias de cada Participación (bloque 2 de la
    // normalización). Toda escritura pasa por la API (Admin SDK). Lectura:
    // superadmin y evaluador a todas; mandante_admin y mandante_lector solo
    // a las de su propio Mandante.
    function puedeLeerDeMandante(mandanteId) {
      return tieneRol("superadmin") || tieneRol("evaluador") ||
          ((tieneRol("mandante_admin") || tieneRol("mandante_lector")) &&
           esDelPropioMandante(mandanteId));
    }

    match /participacionPersonas/{docId} {
      allow read: if puedeLeerDeMandante(resource.data.mandanteId);
      allow write: if false;
    }

    match /participacionRecursos/{docId} {
      allow read: if puedeLeerDeMandante(resource.data.mandanteId);
      allow write: if false;
    }

    // Bloque 4: instancias de Requerimiento por Expediente. Se leen por
    // mandanteId (superadmin y evaluador, todas); nadie escribe desde el
    // cliente (generación, sincronización y evaluaciones son del backend).
    match /expedienteRequerimientos/{docId} {
      allow read: if puedeLeerDeMandante(resource.data.mandanteId);
      allow write: if false;
    }

    // Historial de estados de cada Expediente: lectura por mandanteId; solo
    // el backend escribe (en la misma transacción que el cambio de estado).
    match /expedienteEstados/{docId} {
      allow read: if puedeLeerDeMandante(resource.data.mandanteId);
      allow write: if false;
    }

    // Requerimientos: cada uno pertenece a un Mandante. Se leen por
    // mandanteId (superadmin y evaluador, todos); crear y editar pasan por
    // la API, que los guarda junto con sus vínculos en una transacción.
    match /requerimientos/{docId} {
      allow read: if puedeLeerDeMandante(resource.data.mandanteId);
      allow write: if false;
    }

    // requerimientosNombre: índice de unicidad del nombre, solo backend.
    match /requerimientosNombre/{clave} {
      allow read, write: if false;
    }

    // Bloque 3: relaciones de Empresa. Toda escritura pasa por la API.
    // empresaMandantes: superadmin, evaluador y admin_comercial leen todo;
    // los roles de Mandante, solo los vínculos de su propio Mandante.
    match /empresaMandantes/{docId} {
      allow read: if tieneRol("superadmin") || tieneRol("evaluador") ||
          tieneRol("admin_comercial") ||
          ((tieneRol("mandante_admin") || tieneRol("mandante_lector")) &&
           esDelPropioMandante(resource.data.mandanteId));
      allow write: if false;
    }

    // empresaPersonas / empresaRecursos no llevan mandanteId (la relación
    // laboral no es de un Mandante): lectura directa solo para los roles con
    // visibilidad global; los roles de Mandante las leen por la API, que
    // aplica su alcance. admin_comercial no tiene acceso a personas ni
    // recursos.
    match /empresaPersonas/{docId} {
      allow read: if tieneRol("superadmin") || tieneRol("evaluador");
      allow write: if false;
    }

    match /empresaRecursos/{docId} {
      allow read: if tieneRol("superadmin") || tieneRol("evaluador");
      allow write: if false;
    }

    // Revisiones IA: sesiones, procesamientos y resultados. Solo el backend
    // escribe (Admin SDK); se leen por mandanteId para el progreso en vivo
    // (onSnapshot): superadmin y evaluador, todas; roles de Mandante, las
    // del propio.
    match /sesionesRevision/{docId} {
      allow read: if puedeLeerDeMandante(resource.data.mandanteId);
      allow write: if false;
    }

    match /procesamientosIA/{docId} {
      allow read: if puedeLeerDeMandante(resource.data.mandanteId);
      allow write: if false;
    }

    match /resultadosRevision/{docId} {
      allow read: if puedeLeerDeMandante(resource.data.mandanteId);
      allow write: if false;
    }

    // Configuración de Revisiones IA de un Expediente (ID = expedienteId):
    // solo el backend escribe; lectura por mandanteId.
    match /configRevisionExpediente/{docId} {
      allow read: if puedeLeerDeMandante(resource.data.mandanteId);
      allow write: if false;
    }

    // Catálogo de tipos documentales de Revisiones IA: lectura para
    // usuarios autenticados; solo el backend escribe.
    match /tiposDocumentales/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Plantillas de estructura de carpetas y resultados de completitud
    // (Revisiones IA): solo el backend escribe; lectura por mandanteId.
    match /plantillasEstructura/{docId} {
      allow read: if puedeLeerDeMandante(resource.data.mandanteId);
      allow write: if false;
    }

    match /resultadosCompletitud/{docId} {
      allow read: if puedeLeerDeMandante(resource.data.mandanteId);
      allow write: if false;
    }

    // Fuentes documentales (client secret de SharePoint cifrado): nunca
    // desde el cliente; todo pasa por la API.
    match /fuentesDocumentales/{docId} {
      allow read, write: if false;
    }

    // Configuración de IA (API key cifrada): nunca desde el cliente.
    match /configuracionIA/{docId} {
      allow read, write: if false;
    }

    // empresasRut: índice de unicidad del RUT, solo para el backend.
    match /empresasRut/{rut} {
      allow read, write: if false;
    }

    // Regla base para el resto de colecciones (gestión vía Cloud Functions)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}