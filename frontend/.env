# Base de todos los modos (no definir aquí el ambiente: va en .env.<modo>).
#
# SMARTONE_PROYECTO_PRODUCTIVO: ID del proyecto de Firebase PRODUCTIVO. vite.config.js impide que
# localhost (vite dev) apunte a él. Vacío mientras no haya producción; cuando exista, escriba aquí
# su ID (p. ej. smartone-v3-qa). También se puede pasar como variable de entorno del proceso.
SMARTONE_PROYECTO_PRODUCTIVO=
