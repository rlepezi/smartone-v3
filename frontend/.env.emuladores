# EMULADORES locales (npm run dev:emuladores). Requiere `firebase emulators:start --project qa`.
# Auth, Firestore, Storage y Functions del emulador; la API va a localhost:5001 (apiClient).
VITE_FIREBASE_API_KEY=demo-clave-emulador
VITE_FIREBASE_AUTH_DOMAIN=smartone-v3-qa.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smartone-v3-qa
VITE_FIREBASE_STORAGE_BUCKET=smartone-v3-qa.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:emulador
VITE_USE_FIREBASE_EMULATORS=true
VITE_API_URL=
